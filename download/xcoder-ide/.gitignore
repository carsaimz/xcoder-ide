# XCoder IDE — .gitignore
# Comprehensive Android / Gradle / IDE ignore rules

# ── Built application files ─────────────────────────────────────────────
*.apk
*.ap_
*.aab

# ── Files for the ART/Dalvik VM ───────────────────────────────────────
*.dex

# ── Java class files ───────────────────────────────────────────────────
*.class

# ── Generated files ────────────────────────────────────────────────────
bin/
gen/
out/

# ── Gradle files ───────────────────────────────────────────────────────
.gradle/
build/

# ── Local configuration file (sdk path, etc.) ──────────────────────────
local.properties

# ── IntelliJ / Android Studio ──────────────────────────────────────────
*.iml
.idea/
.navigation/
*.ipr
*.iws

# ── Keystore files ─────────────────────────────────────────────────────
*.jks
*.keystore

# ── External native build folder generated in Android Studio 2.2+ ──────
.externalNativeBuild/
.cxx/

# ── Google Services (keep a private copy elsewhere) ────────────────────
google-services.json

# ── Freeline ───────────────────────────────────────────────────────────
freeline.py
freeline/
freeline_project_description.json

# ── fastlane (keep only production config) ─────────────────────────────
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# ── Version control ────────────────────────────────────────────────────
vcs.xml

# ── Lint ───────────────────────────────────────────────────────────────
lint/intermediates/
lint/generated/
lint/outputs/
lint/tmp/

# ── OS-specific files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ── Log files ──────────────────────────────────────────────────────────
*.log

# ── Android Profiling ──────────────────────────────────────────────────
captures/

# ── Backup files ───────────────────────────────────────────────────────
*.swp
*.swo
*~

# ── Sensitive / secret files ───────────────────────────────────────────
*.env
.env
secrets.properties
keystore.properties

# ── Plugin system artifacts ────────────────────────────────────────────
plugins/build/
plugins/.gradle/

# ── Misc ───────────────────────────────────────────────────────────────
*.hprof