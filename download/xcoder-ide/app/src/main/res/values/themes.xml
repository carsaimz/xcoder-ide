<?xml version="1.0" encoding="utf-8"?>
<!--
  Minimal XML theme definition.
  Most theming is handled by Compose Material 3 (see theme/Theme.kt).
  This file exists for:
    1. Splash screen / cold-start appearance.
    2. Any legacy views (e.g. WebView, dialogs) that don't use Compose.
    3. FileProvider and system UI attributes.
-->
<resources>

    <!-- Base application theme (dark) -->
    <style name="Theme.XCoderIDE" parent="Theme.Material3.Dark.NoActionBar">
        <!-- Primary brand colour -->
        <item name="colorPrimary">@color/purple_primary</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/purple_primary_dark</item>
        <item name="colorOnPrimaryContainer">@color/purple_primary_light</item>

        <!-- Secondary / accent -->
        <item name="colorSecondary">@color/teal_accent</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="colorSecondaryContainer">@color/teal_accent_dark</item>
        <item name="colorOnSecondaryContainer">@color/teal_accent_light</item>

        <!-- Background / surface -->
        <item name="android:colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/purple_primary</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>

        <!-- Window -->
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Activity</item>
    </style>

    <!-- Splash variant – used as the launch theme before Compose takes over -->
    <style name="Theme.XCoderIDE.Splash" parent="Theme.XCoderIDE">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:windowSplashScreenBackground">@color/background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
    </style>

</resources>
