<?xml version="1.0" encoding="utf-8"?>
<!--
  XCoder IDE — Terminal Activity Layout

  Based on Termux's activity_termux.xml layout:
  - DrawerLayout with session list on the left
  - TerminalView in the center
  - Extra keys toolbar at the bottom (above the keyboard)

  This XML layout is the View-based fallback for the terminal.
  The Compose-based [TerminalScreen] composable wraps the same
  Termux components via AndroidView.

  Key differences from Termux:
  1. Uses Material3 drawer instead of custom DrawerLayout
  2. Extra keys use the XCoder color scheme
  3. Session drawer is part of the IDE navigation
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- ════════════════════════════════════════════════════════════
         Main content: terminal toolbar + TerminalView + extra keys
         ════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Terminal toolbar (session name, new session, close) -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/terminal_toolbar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@color/xcoder_surface"
            android:elevation="3dp">

            <ImageButton
                android:id="@+id/btn_toggle_drawer"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle session drawer"
                android:src="@android:drawable/ic_menu_sort_by_size" />

            <TextView
                android:id="@+id/txt_session_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Terminal"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

            <ImageButton
                android:id="@+id/btn_new_session"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="New session"
                android:src="@android:drawable/ic_input_add" />

            <ImageButton
                android:id="@+id/btn_close_session"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close session"
                android:src="@android:drawable/ic_menu_close_clear_cancel" />
        </com.google.android.material.appbar.MaterialToolbar>

        <!-- TerminalView (Termux) → fills remaining space -->
        <com.termux.view.TerminalView
            android:id="@+id/terminal_view"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:scrollbarStyle="insideOverlay" />

        <!-- Extra keys toolbar (above keyboard) -->
        <!--
            In Termux this is a HorizontalScrollView wrapping a
            LinearLayout of toggle/action buttons. The Compose
            equivalent is [ExtraKeysToolbar].
        -->
        <HorizontalScrollView
            android:id="@+id/extra_keys_scroll"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:background="@color/xcoder_terminal_extra_keys_bg"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/extra_keys_row"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Key buttons are added programmatically by TerminalExtraKeys -->
            </LinearLayout>
        </HorizontalScrollView>

    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════
         Session drawer (left) — list of terminal sessions
         ════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/session_drawer"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/xcoder_surface"
        android:elevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- Drawer header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="20dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="Terminal icon"
                    android:src="@android:drawable/ic_menu_view" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Sessions"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/xcoder_divider" />

            <!-- New session button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_drawer_new_session"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="16dp"
                android:text="New Session" />

            <!-- Session list -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/session_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <!-- Footer -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:text="Powered by Termux terminal-emulator"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/xcoder_on_surface_variant" />

        </LinearLayout>
    </FrameLayout>

</androidx.drawerlayout.widget.DrawerLayout>
