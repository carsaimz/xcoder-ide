{
  "log": {
    "prefix": "log",
    "body": ["Log.d(\"${1:TAG}\", \"${2:message}\")"],
    "description": "Android Log.d"
  },
  "log info": {
    "prefix": "logi",
    "body": ["Log.i(\"${1:TAG}\", \"${2:message}\")"],
    "description": "Android Log.i"
  },
  "log error": {
    "prefix": "loge",
    "body": ["Log.e(\"${1:TAG}\", \"${2:message}\", ${3:exception})"],
    "description": "Android Log.e with exception"
  },
  "println": {
    "prefix": "prln",
    "body": ["println(${1:message})"],
    "description": "Print line to stdout"
  },
  "function": {
    "prefix": "fun",
    "body": ["fun ${1:functionName}(${2:params})${3: ReturnType} {", "\t$0", "}"],
    "description": "Function declaration"
  },
  "function with expression body": {
    "prefix": "fune",
    "body": ["fun ${1:functionName}(${2:params}) = ${3:expression}"],
    "description": "Function with expression body"
  },
  "suspend function": {
    "prefix": "sfun",
    "body": ["suspend fun ${1:functionName}(${2:params})${3: ReturnType} {", "\t$0", "}"],
    "description": "Suspend function declaration"
  },
  "extension function": {
    "prefix": "extf",
    "body": ["fun ${1:ReceiverType}.${2:functionName}(${3:params})${4: ReturnType} {", "\t$0", "}"],
    "description": "Extension function"
  },
  "class": {
    "prefix": "class",
    "body": ["class ${1:ClassName}(${2:params}) {", "\t$0", "}"],
    "description": "Class with primary constructor"
  },
  "data class": {
    "prefix": "dataclass",
    "body": ["data class ${1:ClassName}(${2:val ${3:prop}: ${4:Type}})"],
    "description": "Data class"
  },
  "sealed class": {
    "prefix": "sealedclass",
    "body": ["sealed class ${1:Result}<${2:T}> {", "\tdata class Success<${2:T}>(val data: ${2:T}) : ${1:Result}<${2:T>()", "\tdata class Error(val exception: Throwable) : ${1:Result}<Nothing>()", "\tdata object Loading : ${1:Result}<Nothing>()", "}"],
    "description": "Sealed class with common variants"
  },
  "sealed interface": {
    "prefix": "sealedint",
    "body": ["sealed interface ${1:UiEvent} {", "\tdata object NavigateBack : ${1:UiEvent}", "\tdata class ShowMessage(val message: String) : ${1:UiEvent}", "\tdata class ShowError(val error: String) : ${1:UiEvent}", "}"],
    "description": "Sealed interface with common variants"
  },
  "when expression": {
    "prefix": "when",
    "body": ["when (${1:value}) {", "\t${2:condition1} -> {", "\t\t$0", "\t}", "\telse -> {", "\t\t", "\t}", "}"],
    "description": "When expression"
  },
  "when as expression": {
    "prefix": "whene",
    "body": ["val ${1:result} = when (${2:value}) {", "\t${3:condition1} -> ${4:result1}", "\t${5:condition2} -> ${6:result2}", "\telse -> ${7:defaultValue}", "}"],
    "description": "When used as expression"
  },
  "for loop": {
    "prefix": "for",
    "body": ["for (${1:item} in ${2:collection}) {", "\t$0", "}"],
    "description": "For loop"
  },
  "for with index": {
    "prefix": "fori",
    "body": ["for ((${1:index}, ${2:item}) in ${3:collection}.withIndex()) {", "\t$0", "}"],
    "description": "For loop with index"
  },
  "for range": {
    "prefix": "forr",
    "body": ["for (i in ${1:0}..${2:10}) {", "\t$0", "}"],
    "description": "For loop with range"
  },
  "while loop": {
    "prefix": "while",
    "body": ["while (${1:condition}) {", "\t$0", "}"],
    "description": "While loop"
  },
  "coroutine launch": {
    "prefix": "launch",
    "body": ["lifecycleScope.launch {", "\t${1:whenCreated}\n\t$0", "}"],
    "description": "Launch coroutine in lifecycle scope"
  },
  "coroutine launch default": {
    "prefix": "launchd",
    "body": ["CoroutineScope(Dispatchers.Default).launch {", "\t$0", "}"],
    "description": "Launch coroutine on Default dispatcher"
  },
  "viewModel": {
    "prefix": "vm",
    "body": ["@HiltViewModel", "class ${1:MyViewModel} @Inject constructor(", "\t${2:private val repository: ${3:Repository}}", ") : ViewModel() {", "", "\tprivate val _uiState = MutableStateFlow<${4:UiState}>(${5:UiState.Loading})", "\tval uiState: StateFlow<${4:UiState}> = _uiState.asStateFlow()", "", "\tinit {", "\t\t${6:loadData()}", "\t}", "", "\tprivate fun ${6:loadData}() {", "\t\tviewModelScope.launch {", "\t\t\t$0", "\t\t}", "\t}", "}"],
    "description": "ViewModel skeleton with Hilt"
  },
  "composable function": {
    "prefix": "comp",
    "body": ["@Composable", "fun ${1:MyComposable}(", "\t${2:modifier: Modifier = Modifier},", ") {", "\t$0", "}"],
    "description": "Jetpack Composable function"
  },
  "remember": {
    "prefix": "rem",
    "body": ["val ${1:state} = remember { mutableStateOf(${2:initialValue}) }"],
    "description": "Remember mutable state"
  },
  "mutableStateOf": {
    "prefix": "ms",
    "body": ["var ${1:state} by mutableStateOf(${2:initialValue})"],
    "description": "Mutable stateOf delegation"
  },
  "LaunchedEffect": {
    "prefix": "le",
    "body": ["LaunchedEffect(${1:key1}) {", "\t$0", "}"],
    "description": "LaunchedEffect composable side effect"
  },
  "lazy": {
    "prefix": "lazy",
    "body": ["val ${1:property} by lazy {", "\t$0", "}"],
    "description": "Lazy property delegation"
  },
  "lazy column": {
    "prefix": "lazyc",
    "body": ["LazyColumn(", "\tmodifier = ${1:modifier},", "\tcontentPadding = PaddingValues(${2:horizontal = 16.dp, vertical = 8.dp}),", ") {", "\titems(${3:items}, key = { ${4:it.id} }) { ${5:item} ->", "\t\t$0", "\t}", "}"],
    "description": "LazyColumn composable"
  },
  "flow builder": {
    "prefix": "flow",
    "body": ["fun ${1:methodName}(): Flow<${2:T}> = flow {", "\t$0", "}"],
    "description": "Flow builder function"
  },
  "collect flow": {
    "prefix": "collect",
    "body": ["viewModel.uiState", "\t.collectAsStateWithLifecycle()"],
    "description": "Collect state flow in composable"
  },
  "Scaffold": {
    "prefix": "scaffold",
    "body": ["Scaffold(", "\ttopBar = {", "\t\t$0", "\t},", "\tbottomBar = {", "\t\t", "\t},", ") { innerPadding ->", "\t", "}"],
    "description": "Scaffold composable layout"
  },
  "TopAppBar": {
    "prefix": "topapp",
    "body": ["TopAppBar(", "\ttitle = { Text("${1:Title}") },", "\tnavigationIcon = {", "\t\t${2:IconButton}({ ${3:onClick} }) {", "\t\t\t${4:Icon}(\"${5:imageVector}\", contentDescription = null)", "\t\t}", "\t},", ")"],
    "description": "Material TopAppBar composable"
  },
  "BottomNavigationItem": {
    "prefix": "bnav",
    "body": ["BottomNavigationItem(", "\tselected = ${1:currentRoute == item.route},", "\tonClick = { ${2:navigator.navigate(item.route)} },", "\ticon = { ${3:Icon}(item.icon, contentDescription = null) },", "\tlabel = { Text("${4:label}") },", ")"],
    "description": "BottomNavigationItem composable"
  },
  "AlertDialog": {
    "prefix": "alertd",
    "body": ["AlertDialog(", "\tonDismissRequest = { ${1:dismiss} },", "\ttitle = { Text("${2:Title}") },", "\ttext = { Text("${3:Message}") },", "\tconfirmButton = {", "\t\tTextButton(onClick = { ${4:confirm} }) {", "\t\t\tText("${5:Confirm}")", "\t\t}", "\t},", "\tdismissButton = {", "\t\tTextButton(onClick = { ${6:dismiss} }) {", "\t\t\tText("${7:Cancel}")", "\t\t}", "\t},", ")"],
    "description": "AlertDialog composable"
  },
  "RecyclerView adapter": {
    "prefix": "rvadapter",
    "body": ["class ${1:MyAdapter}(private val items: List<${2:Item}>) :", "\tRecyclerView.Adapter<${1:MyAdapter}.${3:ViewHolder}>() {", "", "\tinner class ${3:ViewHolder}(val binding: ${4:ItemBinding}) :", "\t\tRecyclerView.ViewHolder(binding.root)", "", "\toverride fun onCreateViewHolder(parent: ViewGroup, viewType: Int): ${3:ViewHolder} {", "\t\tval binding = ${4:ItemBinding}.inflate(", "\t\t\tLayoutInflater.from(parent.context), parent, false", "\t\t)", "\t\treturn ${3:ViewHolder}(binding)", "\t}", "", "\toverride fun onBindViewHolder(holder: ${3:ViewHolder}, position: Int) {", "\t\tval item = items[position]", "\t\t$0", "\t}", "", "\toverride fun getItemCount() = items.size", "}"],
    "description": "RecyclerView adapter with ViewBinding"
  },
  "Room entity": {
    "prefix": "roomentity",
    "body": ["@Entity(tableName = \"${1:table_name}\")", "data class ${2:EntityName}(", "\t@PrimaryKey(autoGenerate = true) val id: Int = 0,", "\t${3:val column: Type}", ")"],
    "description": "Room database entity"
  },
  "Room DAO": {
    "prefix": "roomdao",
    "body": ["@Dao", "interface ${1:MyDao} {", "\t@Query(\"SELECT * FROM ${2:table_name}\")", "\tfun getAll(): Flow<List<${3:Entity}>>", "", "\t@Query(\"SELECT * FROM ${2:table_name} WHERE id = :id\")", "\tfun getById(id: Int): Flow<${3:Entity}?>", "", "\t@Insert(onConflict = OnConflictStrategy.REPLACE)", "\tsuspend fun insert(${4:item}: ${3:Entity})", "", "\t@Delete", "\tsuspend fun delete(${4:item}: ${3:Entity})", "", "\t@Query(\"DELETE FROM ${2:table_name}\")", "\tsuspend fun deleteAll()", "}"],
    "description": "Room Data Access Object"
  },
  "Hilt inject": {
    "prefix": "hilt",
    "body": ["@Inject constructor(", "\t${1:private val dependency: ${2:Dependency}}", ")"],
    "description": "Hilt constructor injection"
  },
  "if/else": {
    "prefix": "if",
    "body": ["if (${1:condition}) {", "\t$0", "} else {", "\t", "}"],
    "description": "If/else statement"
  },
  "try/catch": {
    "prefix": "try",
    "body": ["try {", "\t$0", "} catch (e: ${1:Exception}) {", "\tLog.e(\"${2:TAG}\", \"Error\", e)", "}"],
    "description": "Try/catch block"
  },
  "null check": {
    "prefix": "nn",
    "body": ["${1:value}?.let {", "\t$0", "}"],
    "description": "Null-safe let block"
  },
  "apply scope": {
    "prefix": "apply",
    "body": ["${1:value}.apply {", "\t$0", "}"],
    "description": "Apply scope function"
  },
  "also scope": {
    "prefix": "also",
    "body": ["${1:value}.also {", "\t$0", "}"],
    "description": "Also scope function"
  },
  "string template": {
    "prefix": "st",
    "body": ["\"${1:\${${2:value}}}\""],
    "description": "String template"
  },
  "listOf": {
    "prefix": "list",
    "body": ["val ${1:list} = listOf(${2:elements})"],
    "description": "Create an immutable list"
  },
  "mutableListOf": {
    "prefix": "mlist",
    "body": ["val ${1:list} = mutableListOf<${2:T}>()"],
    "description": "Create a mutable list"
  },
  "mapOf": {
    "prefix": "map",
    "body": ["val ${1:map} = mapOf(${2:key} to ${3:value})"],
    "description": "Create an immutable map"
  },
  "companion object": {
    "prefix": "compobj",
    "body": ["companion object {", "\t$0", "}"],
    "description": "Companion object"
  },
  "object singleton": {
    "prefix": "obj",
    "body": ["object ${1:Singleton} {", "\t$0", "}"],
    "description": "Object declaration (singleton)"
  }
}