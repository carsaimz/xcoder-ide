<?xml version="1.0" encoding="utf-8"?>
<!--
  XCoder IDE Color Resources — Light Theme

  Naming convention (inspired by Sketchware-IA semantic prefixes):
    xcoder_*    – Brand / primary palette
    studio_*    – IDE panel surfaces & chrome
    editor_*    – Code editor specific
    file_*       – File-type icon/indicator colors
    git_*        – Version control semantic colors
    diff_*       – Diff viewer colors
    semantic_*   – Status / feedback (success, warning, error, info)

  Dark-theme overrides live in values-night/colors.xml.
  Compose tokens mirror these in theme/Color.kt.
-->
