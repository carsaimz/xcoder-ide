{
  "print": {
    "prefix": "pr",
    "body": ["print(${1:message})"],
    "description": "Print statement"
  },
  "print debug": {
    "prefix": "prd",
    "body": ["print(f\"${1:DEBUG}: {${2:variable}}\")"],
    "description": "Debug print with f-string"
  },
  "print f-string": {
    "prefix": "prf",
    "body": ["print(f\"${1:text} {${2:variable}}\")"],
    "description": "Print with f-string"
  },
  "function": {
    "prefix": "def",
    "body": ["def ${1:function_name}(${2:params}):", "\t${3:pass}"],
    "description": "Function definition"
  },
  "function with docstring": {
    "prefix": "defd",
    "body": ["def ${1:function_name}(${2:params}):", "\t\"\"\"${3:Docstring.}\"\"\"", "\t$0"],
    "description": "Function with docstring"
  },
  "function with return type": {
    "prefix": "deft",
    "body": ["def ${1:function_name}(${2:params}) -> ${3:return_type}:", "\t$0"],
    "description": "Function with type hints"
  },
  "class": {
    "prefix": "cls",
    "body": ["class ${1:ClassName}:", "\tdef __init__(self${2:, params}):", "\t\t$0"],
    "description": "Class with constructor"
  },
  "class with docstring": {
    "prefix": "clsd",
    "body": ["class ${1:ClassName}:", "\t\"\"\"${2:Class docstring.}\"\"\"", "", "\tdef __init__(self${3:, params}):", "\t\t$0"],
    "description": "Class with docstring and constructor"
  },
  "dataclass": {
    "prefix": "dc",
    "body": ["@dataclass", "class ${1:ClassName}:", "\t${2:field}: ${3:type} = ${4:default}"],
    "description": "Data class (Python 3.7+)"
  },
  "for loop": {
    "prefix": "for",
    "body": ["for ${1:item} in ${2:iterable}:", "\t$0"],
    "description": "For loop"
  },
  "for with enumerate": {
    "prefix": "fori",
    "body": ["for ${1:index}, ${2:item} in enumerate(${3:iterable}):", "\t$0"],
    "description": "For loop with enumerate"
  },
  "for range": {
    "prefix": "forr",
    "body": ["for ${1:i} in range(${2:start}, ${3:end}):", "\t$0"],
    "description": "For loop with range"
  },
  "if statement": {
    "prefix": "if",
    "body": ["if ${1:condition}:", "\t$0"],
    "description": "If statement"
  },
  "if/else statement": {
    "prefix": "ife",
    "body": ["if ${1:condition}:", "\t$0", "else:", "\t"],
    "description": "If/else statement"
  },
  "if/elif/else": {
    "prefix": "ifee",
    "body": ["if ${1:condition1}:", "\t$0", "elif ${2:condition2}:", "\t", "else:", "\t"],
    "description": "If/elif/else statement"
  },
  "try/except": {
    "prefix": "try",
    "body": ["try:", "\t$0", "except ${1:Exception} as ${2:e}:", "\tprint(${2:e})"],
    "description": "Try/except block"
  },
  "try/except/else/finally": {
    "prefix": "tryf",
    "body": ["try:", "\t$0", "except ${1:Exception} as ${2:e}:", "\tprint(${2:e})", "else:", "\t", "finally:", "\t"],
    "description": "Try/except/else/finally block"
  },
  "list comprehension": {
    "prefix": "lc",
    "body": ["[${1:expression} for ${2:item} in ${3:iterable} if ${4:condition}]"],
    "description": "List comprehension"
  },
  "dict comprehension": {
    "prefix": "dic",
    "body": ["{${1:key}: ${2:value} for ${3:item} in ${4:iterable}}"],
    "description": "Dictionary comprehension"
  },
  "with statement": {
    "prefix": "with",
    "body": ["with ${1:expression} as ${2:var}:", "\t$0"],
    "description": "With context manager"
  },
  "with open": {
    "prefix": "witho",
    "body": ["with open('${1:file_path}', '${2:r}') as ${3:f}:", "\t$0"],
    "description": "Open file with context manager"
  },
  "lambda": {
    "prefix": "lam",
    "body": ["lambda ${1:params}: ${2:expression}"],
    "description": "Lambda expression"
  },
  "import": {
    "prefix": "imp",
    "body": ["import ${1:module}"],
    "description": "Import module"
  },
  "from import": {
    "prefix": "fimp",
    "body": ["from ${1:module} import ${2:name}"],
    "description": "From module import name"
  },
  "import alias": {
    "prefix": "impa",
    "body": ["import ${1:module} as ${2:alias}"],
    "description": "Import with alias"
  },
  "async def": {
    "prefix": "adef",
    "body": ["async def ${1:function_name}(${2:params}):", "\t$0"],
    "description": "Async function definition"
  },
  "async for": {
    "prefix": "afor",
    "body": ["async for ${1:item} in ${2:async_iterable}:", "\t$0"],
    "description": "Async for loop"
  },
  "async with": {
    "prefix": "awith",
    "body": ["async with ${1:expression} as ${2:var}:", "\t$0"],
    "description": "Async with context manager"
  },
  "await": {
    "prefix": "aw",
    "body": ["${1:result} = await ${2:coroutine}"],
    "description": "Await expression"
  },
  "decorator": {
    "prefix": "dec",
    "body": ["@${1:decorator_name}", "def ${2:function_name}(${3:params}):", "\t$0"],
    "description": "Function with decorator"
  },
  "property decorator": {
    "prefix": "prop",
    "body": ["@property", "def ${1:property_name}(self) -> ${2:type}:", "\t$0"],
    "description": "Property decorator"
  },
  "f-string": {
    "prefix": "fs",
    "body": ["f\"${1:text} {${2:variable}}\""],
    "description": "F-string literal"
  },
  "type hint variable": {
    "prefix": "vart",
    "body": ["${1:var_name}: ${2:type} = ${3:value}"],
    "description": "Variable with type hint"
  },
  "type hints function full": {
    "prefix": "deftf",
    "body": ["def ${1:function_name}(${2:param}: ${3:type}) -> ${4:return_type}:", "\t$0"],
    "description": "Function with full type hints"
  },
  "pathlib read": {
    "prefix": "pread",
    "body": ["from pathlib import Path", "", "content = Path('${1:file.txt}').read_text(${2:encoding='utf-8'})", "$0"],
    "description": "Read file using pathlib"
  },
  "pathlib write": {
    "prefix": "pwrite",
    "body": ["from pathlib import Path", "", "Path('${1:file.txt}').write_text(${2:data}, ${3:encoding='utf-8'})", "$0"],
    "description": "Write file using pathlib"
  },
  "logging": {
    "prefix": "log",
    "body": ["import logging", "", "logger = logging.getLogger(__name__)"],
    "description": "Import and setup logging"
  },
  "logging basic config": {
    "prefix": "logc",
    "body": ["import logging", "", "logging.basicConfig(", "\tlevel=logging.${1:INFO},", "\tformat='%(asctime)s - %(name)s - %(levelname)s - %(message)s',", ")", "logger = logging.getLogger(__name__)"],
    "description": "Logging with basic config"
  },
  "argparse": {
    "prefix": "argp",
    "body": ["import argparse", "", "parser = argparse.ArgumentParser(description='${1:Description}')", "parser.add_argument('${2:--arg}', type=${3:str}, default='${4:default}', help='${5:Help text}')", "args = parser.parse_args()", "$0"],
    "description": "Argument parser setup"
  },
  "main guard": {
    "prefix": "main",
    "body": ["if __name__ == '__main__':", "\t$0"],
    "description": "Main entry point guard"
  },
  "assert": {
    "prefix": "assert",
    "body": ["assert ${1:condition}, \"${2:Error message}\""],
    "description": "Assert statement"
  },
  "raise": {
    "prefix": "raise",
    "body": ["raise ${1:Exception}(\"${2:message}\")"],
    "description": "Raise exception"
  }
}