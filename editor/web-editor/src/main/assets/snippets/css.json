{
  "flex center": {
    "prefix": "flexc",
    "body": ["display: flex;", "justify-content: center;", "align-items: center;", "$0"],
    "description": "Flexbox center (horizontal and vertical)"
  },
  "flex center horizontal": {
    "prefix": "flexch",
    "body": ["display: flex;", "justify-content: center;", "$0"],
    "description": "Flexbox center horizontally"
  },
  "flex center vertical": {
    "prefix": "flexcv",
    "body": ["display: flex;", "align-items: center;", "$0"],
    "description": "Flexbox center vertically"
  },
  "flex column": {
    "prefix": "flexcol",
    "body": ["display: flex;", "flex-direction: column;", "$0"],
    "description": "Flexbox column layout"
  },
  "flex row": {
    "prefix": "flexrow",
    "body": ["display: flex;", "flex-direction: row;", "$0"],
    "description": "Flexbox row layout"
  },
  "flex space between": {
    "prefix": "flexsb",
    "body": ["display: flex;", "justify-content: space-between;", "align-items: center;", "$0"],
    "description": "Flexbox space between"
  },
  "flex wrap": {
    "prefix": "flexw",
    "body": ["display: flex;", "flex-wrap: wrap;", "gap: ${1:16px};", "$0"],
    "description": "Flexbox with wrap and gap"
  },
  "grid template": {
    "prefix": "grid",
    "body": ["display: grid;", "grid-template-columns: repeat(${1:3}, 1fr);", "gap: ${2:16px};", "$0"],
    "description": "CSS Grid layout"
  },
  "grid auto fill": {
    "prefix": "gridaf",
    "body": ["display: grid;", "grid-template-columns: repeat(auto-fill, minmax(${1:250px}, 1fr));", "gap: ${2:16px};", "$0"],
    "description": "CSS Grid with auto-fill"
  },
  "grid area": {
    "prefix": "grida",
    "body": ["display: grid;", "grid-template-areas:", "\t\"${1:header header header}\"", "\t\"${2:sidebar main main}\"", "\t\"${3:footer footer footer}\";", "grid-template-columns: ${4:200px} 1fr;", "grid-template-rows: ${5:60px} 1fr ${6:40px};", "$0"],
    "description": "CSS Grid with named areas"
  },
  "media query": {
    "prefix": "mq",
    "body": ["@media (${1:max-width}: ${2:768px}) {", "\t$0", "}"],
    "description": "Media query"
  },
  "media query mobile first": {
    "prefix": "mqmin",
    "body": ["@media (min-width: ${1:768px}) {", "\t$0", "}"],
    "description": "Min-width media query (mobile first)"
  },
  "media query prefers-color-scheme": {
    "prefix": "mqdark",
    "body": ["@media (prefers-color-scheme: dark) {", "\t$0", "}"],
    "description": "Dark mode media query"
  },
  "container query": {
    "prefix": "cq",
    "body": ["@container (${1:min-width}: ${2:400px}) {", "\t$0", "}"],
    "description": "Container query"
  },
  "container type": {
    "prefix": "ct",
    "body": ["container-type: ${1:inline-size};", "container-name: ${2:container};", "$0"],
    "description": "Container type definition"
  },
  "keyframes": {
    "prefix": "kf",
    "body": ["@keyframes ${1:animationName} {", "\t0% {", "\t\t${2:opacity: 0;}", "\t}", "\t100% {", "\t\t${3:opacity: 1;}", "\t}", "}"],
    "description": "Keyframes block"
  },
  "keyframes slide in": {
    "prefix": "kfslide",
    "body": ["@keyframes slideIn {", "\tfrom {", "\t\ttransform: translateX(${1:-100%});", "\t\topacity: 0;", "\t}", "\tto {", "\t\ttransform: translateX(0);", "\t\topacity: 1;", "\t}", "}"],
    "description": "Slide in keyframes"
  },
  "keyframes fade in": {
    "prefix": "kffade",
    "body": ["@keyframes fadeIn {", "\tfrom { opacity: 0; }", "\tto { opacity: 1; }", "}"],
    "description": "Fade in keyframes"
  },
  "animation": {
    "prefix": "anim",
    "body": ["animation: ${1:animationName} ${2:1s} ${3:ease} ${4:forwards};", "$0"],
    "description": "Animation shorthand"
  },
  "transition": {
    "prefix": "trans",
    "body": ["transition: ${1:property} ${2:0.3s} ${3:ease};", "$0"],
    "description": "Transition shorthand"
  },
  "transition all": {
    "prefix": "transa",
    "body": ["transition: all ${1:0.3s} ${2:ease};", "$0"],
    "description": "Transition all properties"
  },
  "transform translate": {
    "prefix": "tft",
    "body": ["transform: translate(${1:x}, ${2:y});"],
    "description": "Transform translate"
  },
  "transform rotate": {
    "prefix": "tfr",
    "body": ["transform: rotate(${1:45deg});"],
    "description": "Transform rotate"
  },
  "transform scale": {
    "prefix": "tfs",
    "body": ["transform: scale(${1:1.5});"],
    "description": "Transform scale"
  },
  "box shadow": {
    "prefix": "shadow",
    "body": ["box-shadow: ${1:0} ${2:4px} ${3:6px} ${4:rgba(0, 0, 0, 0.1)};"],
    "description": "Box shadow"
  },
  "text shadow": {
    "prefix": "tshadow",
    "body": ["text-shadow: ${1:0} ${2:2px} ${3:4px} ${4:rgba(0, 0, 0, 0.3)};"],
    "description": "Text shadow"
  },
  "linear gradient": {
    "prefix": "lgrad",
    "body": ["background: linear-gradient(${1:to right}, ${2:#ff7e5f}, ${3:#feb47b});"],
    "description": "Linear gradient background"
  },
  "radial gradient": {
    "prefix": "rgrad",
    "body": ["background: radial-gradient(${1:circle}, ${2:#ff7e5f}, ${3:#feb47b});"],
    "description": "Radial gradient background"
  },
  "custom property": {
    "prefix": "cprop",
    "body": ["${1:--variable-name}: ${2:value};"],
    "description": "CSS custom property (variable) definition"
  },
  "use css variable": {
    "prefix": "varr",
    "body": ["var(${1:--variable-name})"],
    "description": "Use CSS variable"
  },
  ":root variables": {
    "prefix": "root",
    "body": [":root {", "\t--color-primary: ${1:#3b82f6};", "\t--color-secondary: ${2:#6366f1};", "\t--color-background: ${3:#ffffff};", "\t--color-text: ${4:#1f2937};", "\t--color-muted: ${5:#6b7280};", "\t--font-size-base: ${6:16px};", "\t--spacing: ${7:8px};", "\t--radius: ${8:8px};", "\t$0", "}"],
    "description": ":root CSS custom properties"
  },
  "clamp": {
    "prefix": "clamp",
    "body": ["font-size: clamp(${1:1rem}, ${2:2.5vw}, ${3:2rem});", "$0"],
    "description": "CSS clamp() for responsive sizing"
  },
  "aspect-ratio": {
    "prefix": "aspect",
    "body": ["aspect-ratio: ${1:16} / ${2:9};"],
    "description": "Aspect ratio"
  },
  "scroll-snap": {
    "prefix": "snap",
    "body": ["scroll-snap-type: ${1:x mandatory};", "overflow-x: ${2:auto};", "$0"],
    "description": "Scroll snap container"
  },
  "scroll-snap align": {
    "prefix": "snapa",
    "body": ["scroll-snap-align: ${1:start};"],
    "description": "Scroll snap alignment on children"
  },
  "@font-face": {
    "prefix": "fontface",
    "body": ["@font-face {", "\tfont-family: '${1:FontName}';", "\tsrc: url('${2:font.woff2}') format('${3:woff2}');", "\tfont-weight: ${4:normal};", "\tfont-style: ${5:normal};", "\tfont-display: ${6:swap};", "}"],
    "description": "@font-face declaration"
  },
  "backdrop-filter": {
    "prefix": "backdrop",
    "body": ["backdrop-filter: blur(${1:10px});", "background: rgba(${2:0, 0, 0}, ${3:0.1});", "$0"],
    "description": "Backdrop filter blur effect"
  },
  "position absolute center": {
    "prefix": "posac",
    "body": ["position: absolute;", "top: 50%;", "left: 50%;", "transform: translate(-50%, -50%);", "$0"],
    "description": "Absolute position center"
  },
  "position sticky": {
    "prefix": "posst",
    "body": ["position: sticky;", "top: ${1:0};", "z-index: ${2:100};", "$0"],
    "description": "Sticky position"
  },
  "text truncate": {
    "prefix": "trunc",
    "body": ["overflow: hidden;", "text-overflow: ellipsis;", "white-space: nowrap;"],
    "description": "Text truncation with ellipsis"
  },
  "text line clamp": {
    "prefix": "lclamp",
    "body": ["display: -webkit-box;", "-webkit-line-clamp: ${1:2};", "-webkit-box-orient: vertical;", "overflow: hidden;"],
    "description": "Multi-line text clamping"
  },
  "scrollbar styling": {
    "prefix": "scrollbar",
    "body": ["&::-webkit-scrollbar {", "\twidth: ${1:8px};", "\theight: ${1:8px};", "}", "&::-webkit-scrollbar-track {", "\tbackground: ${2:transparent};", "}", "&::-webkit-scrollbar-thumb {", "\tbackground: ${3:#888};", "\tborder-radius: ${4:4px};", "}", "&::-webkit-scrollbar-thumb:hover {", "\tbackground: ${5:#555};", "}"],
    "description": "Custom scrollbar styling"
  }
}